{
  "name": "ashlands",
  "version": "0.1.0",
  "description": "Ashlands — програма-помічник для темної DnD-кампанії",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "make-dm": "node --env-file-if-exists=.env scripts/make-dm.js",
    "make-test-models": "node scripts/make-test-models.js"
  },
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "delaunator": "^5.1.0",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "three": "^0.187.0"
  }
}
