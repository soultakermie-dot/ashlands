# Скопіюй цей файл як .env і впиши свої значення.
# .env НЕ потрапляє в git — секретний ключ ніколи не викладай на GitHub.
# Якщо ключів нема — гра зберігає дані у файли в папці data/.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...)
# (або старий service_role key з вкладки «Legacy API Keys»)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
